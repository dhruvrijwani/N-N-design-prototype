{%- comment -%}
  Nurture & Next: delivery by region table. One block per region.
  Stacks into cards on phones.
{%- endcomment -%}
<div class="section section--divider-{{ section.settings.divider_style }} {{ section.settings.section_padding }} nn-delivery">
  <div class="section__inner">
    {%- if section.settings.accent != blank -%}<p class="nn-delivery__accent">{{ section.settings.accent }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="ff-heading fs-heading-3-base">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="nn-delivery__box">
      <table class="nn-delivery__t">
        <thead><tr><th>Region</th><th>Estimated delivery</th><th>Charges</th></tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr class="{% if block.settings.highlight %}is-free{% endif %}" {{ block.shopify_attributes }}>
              <td><b>{{ block.settings.region }}</b>{{ block.settings.note }}</td>
              <td data-l="Delivery">{{ block.settings.delivery }}</td>
              <td data-l="Charge">{%- if block.settings.highlight -%}<span class="nn-delivery__free">{{ block.settings.charge }}</span>{%- else -%}{{ block.settings.charge }}{%- endif -%}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .nn-delivery__accent { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #7d6358; margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .nn-delivery__box { margin-top: 28px; padding: clamp(20px, 3vw, 40px); background: #262729; color: #b9b2aa; border-radius: 14px; }
  #shopify-section-{{ section.id }} .nn-delivery__t { width: 100%; border-collapse: collapse; font-size: .875rem; }
  #shopify-section-{{ section.id }} .nn-delivery__t th { text-align: left; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 0 16px 14px 0; border-bottom: 1px solid #48494d; }
  #shopify-section-{{ section.id }} .nn-delivery__t td { padding: 20px 16px 20px 0; border-bottom: 1px solid #48494d; vertical-align: top; }
  #shopify-section-{{ section.id }} .nn-delivery__t td b { display: block; color: #f8f2eb; font-family: var(--font-heading, serif); font-weight: 400; font-size: 1.15rem; margin-bottom: 4px; }
  #shopify-section-{{ section.id }} .nn-delivery__t tr.is-free td { background: rgba(255,255,255,.05); }
  #shopify-section-{{ section.id }} .nn-delivery__free { display: inline-block; padding: 4px 9px; border-radius: 20px; background: #e0c16e; color: #262729; font-size: 10px; font-weight: 700; letter-spacing: .1em; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .nn-delivery__t thead { display: none; }
    #shopify-section-{{ section.id }} .nn-delivery__t, #shopify-section-{{ section.id }} .nn-delivery__t tbody, #shopify-section-{{ section.id }} .nn-delivery__t tr, #shopify-section-{{ section.id }} .nn-delivery__t td { display: block; width: 100%; }
    #shopify-section-{{ section.id }} .nn-delivery__t tr { padding: 18px 0; border-bottom: 1px solid #48494d; }
    #shopify-section-{{ section.id }} .nn-delivery__t td { border: 0; padding: 4px 0; }
    #shopify-section-{{ section.id }} .nn-delivery__t td[data-l]::before { content: attr(data-l) ": "; color: #f8f2eb; font-weight: 600; }
  }
</style>

{% schema %}
{
  "name": "Delivery table",
  "tag": "section",
  "class": "nn-delivery-table",
  "settings": [
    { "type": "text", "id": "accent", "label": "Accent", "default": "Shipping & delivery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little deliveries, on their way." },
    { "type": "select", "id": "divider_style", "label": "Divider", "options": [ { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid" } ], "default": "none" },
    { "type": "select", "id": "section_padding", "label": "Padding", "options": [
      { "value": "section--vertical-padding-none", "label": "None" },
      { "value": "section--vertical-padding-top-bottom", "label": "Top and bottom" },
      { "value": "section--vertical-padding-top-only", "label": "Top only" },
      { "value": "section--vertical-padding-bottom-only", "label": "Bottom only" } ], "default": "section--vertical-padding-top-bottom" }
  ],
  "blocks": [
    {
      "type": "region",
      "name": "Region",
      "settings": [
        { "type": "text", "id": "region", "label": "Region", "default": "Dubai" },
        { "type": "textarea", "id": "note", "label": "Note" },
        { "type": "text", "id": "delivery", "label": "Estimated delivery", "default": "Next business day" },
        { "type": "text", "id": "charge", "label": "Charge", "default": "AED 30" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight (free shipping row)", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Delivery table", "blocks": [
    { "type": "region", "settings": { "region": "Dubai", "note": "Next-business-day delivery for orders placed by 5 PM on the preceding business day.", "delivery": "Next business day", "charge": "AED 30" } },
    { "type": "region", "settings": { "region": "Other UAE emirates", "note": "Estimates are in business days and may vary during holidays and peak periods.", "delivery": "2–4 business days", "charge": "AED 30" } },
    { "type": "region", "settings": { "region": "UAE orders over AED 500", "note": "Tracking details are shared once the order is dispatched.", "delivery": "As above", "charge": "FREE", "highlight": true } },
    { "type": "region", "settings": { "region": "GCC", "note": "Availability and charges are shown at checkout.", "delivery": "About 3–7 business days", "charge": "At checkout" } },
    { "type": "region", "settings": { "region": "Other supported countries", "note": "Customs duties and import taxes are the customer’s responsibility where applicable.", "delivery": "About 5–10 business days", "charge": "At checkout" } }
  ] } ]
}
{% endschema %}
